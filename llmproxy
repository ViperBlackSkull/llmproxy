#!/bin/bash

# llmproxy - Transparent LLM API proxy wrapper
# Intercepts all LLM API traffic by setting the right env vars for each agent,
# then forwarding through a local proxy that logs everything.

set -e

SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
LOG_DIR="${LOG_DIR:-$SCRIPT_DIR/logs}"

# --- Subcommands ---

cmd_logs() {
    shift
    mkdir -p "$LOG_DIR"
    if [[ $# -gt 0 && "$1" == "open" ]]; then
        PORT="${2:-8777}"
        echo "Inspect dashboard: http://localhost:$PORT/__inspect__" >&2
        echo "Press Ctrl+C to stop" >&2
        LOG_DIR="$LOG_DIR" LISTEN_ADDR=":$PORT" BACKEND_URL="http://localhost" "$SCRIPT_DIR/llmproxyd"
        exit $?
    fi
    if ls "$LOG_DIR"/*.md &>/dev/null; then
        for f in "$LOG_DIR"/*.md; do
            basename "$f"
        done | sort -r
    else
        echo "No logs found in $LOG_DIR"
    fi
    exit 0
}

cmd_inspect() {
    shift
    mkdir -p "$LOG_DIR"
    PORT="${1:-8777}"
    echo "Inspect dashboard: http://localhost:$PORT/__inspect__" >&2
    echo "Press Ctrl+C to stop" >&2
    LOG_DIR="$LOG_DIR" LISTEN_ADDR=":$PORT" BACKEND_URL="http://localhost" "$SCRIPT_DIR/llmproxyd"
    exit $?
}

cmd_help() {
    cat <<EOF
Usage: llmproxy <command> [args...]

Transparent LLM API proxy. Wraps any coding agent and captures all
prompt traffic to markdown logs with a web dashboard.

Supported agents (auto-detected):
  claude            Claude Code (Anthropic)
  codex             OpenAI Codex CLI
  aider             Aider
  opencode          OpenCode
  gemini            Gemini CLI
  *                 Any other command (set BACKEND_URL manually)

Commands:
  logs              List captured logs
  logs open         Open inspect dashboard on historical logs
  inspect [port]    Open inspect dashboard (default: 8777)

Examples:
  llmproxy claude -p "hello"
  llmproxy codex "fix the bug"
  llmproxy aider --model gpt-4o "refactor auth"
  llmproxy opencode
  llmproxy gemini -p "explain this code"

Environment:
  BACKEND_URL       Override backend URL (skips auto-detection)
  LOG_DIR           Directory for logs (default: ./logs)
  PROXY_PORT        Force a specific proxy port
EOF
    exit 0
}

if [[ $# -eq 0 ]]; then
    cmd_help
fi

case "${1:-}" in
    logs)   cmd_logs "$@" ;;
    inspect) cmd_inspect "$@" ;;
    help|--help|-h) cmd_help ;;
esac

# --- Agent detection ---

AGENT_CMD="$1"
AGENT_TYPE="unknown"

case "$(basename "$AGENT_CMD")" in
    claude)         AGENT_TYPE="claude" ;;
    codex)          AGENT_TYPE="codex" ;;
    aider)          AGENT_TYPE="aider" ;;
    opencode)       AGENT_TYPE="opencode" ;;
    gemini)         AGENT_TYPE="gemini" ;;
    *)              AGENT_TYPE="generic" ;;
esac

# --- Find proxy daemon ---

PROXYD="$SCRIPT_DIR/llmproxyd"
if [[ ! -x "$PROXYD" ]]; then
    echo "Error: Cannot find llmproxyd binary. Run 'make build' first." >&2
    exit 1
fi

# --- Determine backend URL ---

BACKEND_URL="${BACKEND_URL:-}"

if [[ -z "$BACKEND_URL" ]]; then
    case "$AGENT_TYPE" in
        claude)
            # Check existing ANTHROPIC_BASE_URL or Claude settings
            BACKEND_URL="${ANTHROPIC_BASE_URL:-}"
            if [[ -z "$BACKEND_URL" && -f "$HOME/.claude/settings.json" ]]; then
                BACKEND_URL=$(jq -r '.env.ANTHROPIC_BASE_URL // empty' "$HOME/.claude/settings.json" 2>/dev/null || true)
            fi
            BACKEND_URL="${BACKEND_URL:-https://api.anthropic.com}"
            ;;
        codex)
            BACKEND_URL="${OPENAI_BASE_URL:-https://api.openai.com/v1}"
            ;;
        aider)
            # Aider can use either API — check which model is specified
            if [[ "$*" == *"--model"* ]]; then
                MODEL_ARG=$(echo "$*" | grep -oP '(?<=--model\s)\S+')
                if [[ "$MODEL_ARG" == anthropic/* || "$MODEL_ARG" == claude* ]]; then
                    BACKEND_URL="${ANTHROPIC_API_BASE:-https://api.anthropic.com}"
                else
                    BACKEND_URL="${OPENAI_API_BASE:-https://api.openai.com/v1}"
                fi
            else
                # Default to OpenAI
                BACKEND_URL="${OPENAI_API_BASE:-${OPENAI_API_BASE_URL:-https://api.openai.com/v1}}"
            fi
            ;;
        opencode)
            # OpenCode supports multiple providers — prefer whichever has a key set
            if [[ -n "${ANTHROPIC_API_KEY:-}" ]]; then
                BACKEND_URL="${ANTHROPIC_BASE_URL:-https://api.anthropic.com}"
            elif [[ -n "${OPENAI_API_KEY:-}" ]]; then
                BACKEND_URL="${OPENAI_BASE_URL:-https://api.openai.com/v1}"
            else
                BACKEND_URL="${OPENAI_BASE_URL:-https://api.openai.com/v1}"
            fi
            ;;
        gemini)
            BACKEND_URL="${GOOGLE_GEMINI_BASE_URL:-https://generativelanguage.googleapis.com}"
            ;;
        *)
            # Generic — try to guess from available env vars
            if [[ -n "${ANTHROPIC_API_KEY:-}" && -z "${OPENAI_API_KEY:-}" ]]; then
                BACKEND_URL="${ANTHROPIC_BASE_URL:-https://api.anthropic.com}"
            elif [[ -n "${OPENAI_API_KEY:-}" && -z "${ANTHROPIC_API_KEY:-}" ]]; then
                BACKEND_URL="${OPENAI_BASE_URL:-https://api.openai.com/v1}"
            else
                # Default to Anthropic
                BACKEND_URL="${ANTHROPIC_BASE_URL:-https://api.anthropic.com}"
            fi
            ;;
    esac
fi
BACKEND_URL="${BACKEND_URL%/}"

mkdir -p "$LOG_DIR"

# --- Find available port ---

PROXY_PORT="${PROXY_PORT:-}"
if [[ -z "$PROXY_PORT" ]]; then
    for port in 8765 8766 8767 8768 8769 8770; do
        if ! ss -tlnH | grep -q ":${port} "; then
            PROXY_PORT=$port
            break
        fi
    done
fi

if [[ -z "$PROXY_PORT" ]]; then
    echo "Error: No available port found. Set PROXY_PORT manually." >&2
    exit 1
fi

PROXY_URL="http://localhost:$PROXY_PORT"

# --- Start proxy daemon ---

BACKEND_URL="$BACKEND_URL" \
LISTEN_ADDR=":$PROXY_PORT" \
LOG_DIR="$LOG_DIR" \
"$PROXYD" &
PROXY_PID=$!

sleep 0.3

if ! kill -0 $PROXY_PID 2>/dev/null; then
    echo "Error: Proxy failed to start" >&2
    exit 1
fi

# --- Configure agent to use proxy ---

SETTINGS_BACKUP=""
ENV_EXPORTS=()

case "$AGENT_TYPE" in
    claude)
        # Claude Code: set env var AND patch settings.json for full coverage
        export ANTHROPIC_BASE_URL="$PROXY_URL"
        ENV_EXPORTS+=("ANTHROPIC_BASE_URL=$PROXY_URL")

        SETTINGS_FILE="$HOME/.claude/settings.json"
        if [[ -f "$SETTINGS_FILE" ]]; then
            SETTINGS_BACKUP=$(mktemp)
            cp "$SETTINGS_FILE" "$SETTINGS_BACKUP"
            jq --arg url "$PROXY_URL" '.env.ANTHROPIC_BASE_URL = $url' "$SETTINGS_FILE" > "$SETTINGS_FILE.tmp"
            mv "$SETTINGS_FILE.tmp" "$SETTINGS_FILE"
        fi
        ;;
    codex)
        export OPENAI_BASE_URL="$PROXY_URL"
        ENV_EXPORTS+=("OPENAI_BASE_URL=$PROXY_URL")
        ;;
    aider)
        # Aider reads both depending on model
        export OPENAI_API_BASE="$PROXY_URL"
        export ANTHROPIC_API_BASE="$PROXY_URL"
        ENV_EXPORTS+=("OPENAI_API_BASE=$PROXY_URL" "ANTHROPIC_API_BASE=$PROXY_URL")
        ;;
    opencode)
        export OPENAI_BASE_URL="$PROXY_URL"
        export ANTHROPIC_BASE_URL="$PROXY_URL"
        ENV_EXPORTS+=("OPENAI_BASE_URL=$PROXY_URL" "ANTHROPIC_BASE_URL=$PROXY_URL")
        ;;
    gemini)
        export GOOGLE_GEMINI_BASE_URL="$PROXY_URL"
        ENV_EXPORTS+=("GOOGLE_GEMINI_BASE_URL=$PROXY_URL")
        ;;
    *)
        # Set everything — the agent will read what it needs
        export ANTHROPIC_BASE_URL="$PROXY_URL"
        export OPENAI_BASE_URL="$PROXY_URL"
        export OPENAI_API_BASE="$PROXY_URL"
        export ANTHROPIC_API_BASE="$PROXY_URL"
        export GOOGLE_GEMINI_BASE_URL="$PROXY_URL"
        ;;
esac

# --- Cleanup ---

cleanup() {
    if [[ -n "$SETTINGS_BACKUP" && -f "$SETTINGS_BACKUP" ]]; then
        mv "$SETTINGS_BACKUP" "$HOME/.claude/settings.json"
    fi
    kill $PROXY_PID 2>/dev/null || true
    wait $PROXY_PID 2>/dev/null || true

    local count=0
    for f in "$LOG_DIR"/*.md; do
        if [[ -f "$f" ]]; then
            count=$((count + 1))
        fi
    done
    if [[ $count -gt 0 ]]; then
        echo "" >&2
        echo "[$AGENT_TYPE] Captured $count request(s). Inspect: llmproxy inspect" >&2
    fi
}
trap cleanup EXIT

# --- Run the command ---

log_proxy() {
    echo "[llmproxy] agent=$AGENT_TYPE backend=$BACKEND_URL proxy=:$PROXY_PORT" >&2
}
log_proxy

"$@"
EXIT_CODE=$?

exit $EXIT_CODE
