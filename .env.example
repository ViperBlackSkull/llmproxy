# llmproxy daemon configuration.
# Copy to .env and fill in your values:  cp .env.example .env
# The daemon loads ./.env at startup (real environment variables win over
# .env values). .env is gitignored — never commit real keys.

# LLM API keys — injected upstream for credential-free proxying
# (self-referential BASE_URL traffic) and in non-transparent / override mode.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Per-provider backend overrides (optional)
# Point ANTHROPIC_BACKEND at z.ai's Anthropic-compatible endpoint and any
# agent configured with base URL http://localhost:8765 gets real completions
# through your z.ai key with zero credentials of its own.
ANTHROPIC_BACKEND=https://api.z.ai/api/anthropic
# ANTHROPIC_BACKEND=https://api.anthropic.com
# OPENAI_BACKEND=https://api.openai.com
# z.ai OpenAI-compatible endpoint (optional alternative):
# OPENAI_BACKEND=https://api.z.ai/api/coding/paas/v4
# GEMINI_BACKEND=https://generativelanguage.googleapis.com

# Model remapping (optional): comma-separated pattern=replacement rules.
# A trailing '*' in the pattern means prefix match; first matching rule wins;
# models that match no rule pass through unchanged.
# Default below remaps Claude model names to z.ai GLM models.
MODEL_MAP=claude-opus-*=glm-5.3,claude-sonnet-*=glm-5.3,claude-haiku-*=glm-5.3,claude-3-5-haiku-*=glm-5.3

# Inspect dashboard: /__inspect__ is disabled (404) until this token is set.
# Access then requires it as a bearer header or ?token= query param.
LLMPROXY_INSPECT_TOKEN=

# Global backend override (all requests go here, optional)
# BACKEND_URL=

# Proxy settings
# PROXY_PORT=8765
# LOG_DIR=./logs
# LISTEN_ADDR=127.0.0.1:8765
