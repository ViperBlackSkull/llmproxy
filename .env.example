# LLM API keys (only needed in non-transparent / override mode)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Per-provider backend overrides (optional)
# ANTHROPIC_BACKEND=https://api.anthropic.com
# OPENAI_BACKEND=https://api.openai.com
# GEMINI_BACKEND=https://generativelanguage.googleapis.com

# Global backend override (all requests go here, optional)
# BACKEND_URL=

# Proxy settings
# PROXY_PORT=8765
# LOG_DIR=./logs
# LISTEN_ADDR=:8765
